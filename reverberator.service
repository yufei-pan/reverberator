[Unit]
Description=Reverberator recursive versioning backup daemon
# Start once the clock is set: read stamps taken under a clock that is later stepped back hide changes from full
# comparisons. time-sync.target waits for the sync only when the time daemon's wait unit is enabled
# (chrony-wait.service, systemd-time-wait-sync.service); without it, use the ExecStartPre wait below.
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
# Reverberator warns when not run as root because some tuning/permissions may fail.
User=root
Group=root

# Update these paths for your installation.
WorkingDirectory=/opt/reverberator
ExecStart=/usr/bin/env python3 /opt/reverberator/reverberator.py /etc/reverberator/reverb_rule.tsv

# With chrony and no wait unit enabled: wait up to ~5 min for the sync, then start anyway (add chrony.service to
# After= so chronyd is up first; the start timeout must cover the wait).
#ExecStartPre=-/usr/bin/chronyc waitsync 30 0.1
#TimeoutStartSec=360
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=5
# Exit status 3: every job is stopped until its rule or skip list is fixed, so restarting would only fail again.
RestartPreventExitStatus=3

# Optional hardening/tuning.
NoNewPrivileges=true
LimitNOFILE=524288

[Install]
WantedBy=multi-user.target
